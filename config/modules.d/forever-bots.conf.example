# Settings for the forever-bots module. Copy this file to worldserver.conf.d/modules.d/forever-bots.conf (under the config directory). The core loads every .conf file under worldserver.conf.d at start-up and sends each
# Module.forever-bots.<Key> entry to the module, with the prefix removed.

# Most bots the module controls at once (1..16).
Module.forever-bots.MaxBots = 1

# Race and class the module spawns bots with. Valid ids for the core's race and class tables.
Module.forever-bots.Race = 1
Module.forever-bots.Class = 1

# Telemetry: one CSV line per event and per summary interval, appended to this file (relative to the module's working directory; use an absolute path to be sure).
# Leave TelemetryFile empty to turn it off. TelemetrySummarySec is the seconds between summary lines per bot (1..3600).
Module.forever-bots.TelemetryFile = forever-bots-telemetry.csv
Module.forever-bots.TelemetrySummarySec = 60

# Scale run (1500 bots): Race and Class may be "random" (a seeded pick over the valid combinations; see src/bot_pick.h).
# RandomSeed makes the same bots come back for the same seed.
#   Module.forever-bots.Race = random
#   Module.forever-bots.Class = random
#   Module.forever-bots.RandomSeed = 20261012
#
# The ramp: start at BotsInitial, add BotsStep every BotsStepMinutes, never above BotsCap, and stop adding at BotsStopTime
# (local time). The core ends the run at the same time (Bot.Run.StopTime in worldserver.conf).
#   Module.forever-bots.MaxBots = 1500
#   Module.forever-bots.BotsInitial = 300
#   Module.forever-bots.BotsStep = 100
#   Module.forever-bots.BotsStepMinutes = 15
#   Module.forever-bots.BotsCap = 1500
#   Module.forever-bots.BotsStopTime = 06:00
#
# The telemetry file rotates at TelemetryMaxMB, keeping TelemetryKeep older files (file.1 is the newest).
#   Module.forever-bots.TelemetryMaxMB = 256
#   Module.forever-bots.TelemetryKeep = 8

# Services (M3): an idle bot visits a vendor (sell grey, repair, equip) every ServiceEverySec seconds. The bot must be in
# interaction range of the NPC, which the core checks; it walks to the nearest vendor first (M6).
#   Module.forever-bots.ServiceEverySec = 600
# The trainer check (M4) is off by default, since bots learn their spells on level-up. TrainEverySec (60..86400) turns it
# on: the bot checks the trainer every that many seconds, and at once after a level-up, when a trainer is in range.
#   Module.forever-bots.TrainEverySec = 600

# Parties (M8): PartyCount parties of PartySize bots, cut from the lowest-guid bots in guid order. PartySize 0 turns
# parties off (the default); at most 5. A party's leader is its first warrior, else its lowest-guid bot. The core applies
# the invites and the group rules; the module only sends the actions. Needs the core with layout 5 (party state).
#   Module.forever-bots.PartySize = 5
#   Module.forever-bots.PartyCount = 1

# Travel (M6): an idle bot due a vendor visit (ServiceEverySec) walks to the nearest vendor on its own map and visits it.
# The core finds the vendor (layout 6 core). Needs no position settings.

# Hubs (M7): a bot that has seen nothing and done nothing for 30 s walks to the next hub of its map, waits there, and walks
# on to the next one after a full interval. Keys Hub<map>_<n> = "x y z", n from 1, in order. Hubs of map 0 and map 1 only.
# A bot with no hubs on its map does not wander. Needs the layout 7 core (map id in the snapshot).
# The hubs are the three biggest quest-giver clusters per map on the sim (rough centres: averages of the cell's givers).
# Map 0: Brill area, south Stranglethorn-side cluster, and the far-west cluster. Map 1: the three largest, well apart.
# A centre may sit in rock or on a roof; a bot that cannot reach it within the walk timeout just tries the next hub.
#   Module.forever-bots.Hub0_1 = 2265.2 269.3 36.5
#   Module.forever-bots.Hub0_2 = 2288.2 -5330.0 87.6
#   Module.forever-bots.Hub0_3 = -14447.1 474.8 19.6
#   Module.forever-bots.Hub1_1 = 2490.5 1903.5 351.2
#   Module.forever-bots.Hub1_2 = -3698.6 -4492.0 25.3
#   Module.forever-bots.Hub1_3 = 6475.8 481.2 9.9

# Quests (M5). The starter quest data file (see data/starter_quests.txt and src/quest_data.h). A bot near one of its starts accepts
# the quests of that start in order, hunts their targets, and hands them in; a bot with no start nearby grinds as before. Empty
# turns quests off.
# QuestFile = data/starter_quests.txt
# A whole-world quest file (levels 1 to 60, made by tools/make_world_quests.py, doc/world-quests.md) works the same way: the bot takes quests that suit its
# level, race and class from the nearest area that has some, and moves on to the next area when one is used up.
# QuestFile = data/world_quests.txt
# A walk to a giver that does not move for two minutes is dropped (the bot grinds) unless this is 1. 1 teleports the bot to the giver
# once; the core still refuses that unless Bot.Actions.Teleport = 1. A refused teleport drops the start either way.
# QuestTeleport = 0

# Auto gear. 1 = the core dresses every bot for its class and level when it first appears and after it gains AutoGearEveryLevels levels
# (best usable item per slot, uncommon quality at most; Bot.AutoGear.MaxQuality in the core's config). Off by default. With it off, a
# player in a party can type .autogear to dress the bots that player leads.
# AutoGearing = 0
#
# Rotations from a file: fight rows and upkeep buffs for all classes up to level 60, with the real spell ids from the core's ability dump
# (tools/make_rotations.py, doc/rotations.md). Without it the built-in rank 1 rotations are used.
# RotationFile = "data/rotations.txt"
#
# Grind spots (leveling): idle bots walk to the spots that suit their level instead of their map's hubs. The file is made from the world database
# (tools/make_grind_spots.py, doc/grind-spots.md).
# GrindFile = "data/grind_spots.txt"
#
# Chat commands (party chat, raid chat, or a whisper to one bot; or the .bots dot command). Both are off by default. Only the leader of a group
# can command the bots in it. ChatCommands: follow [off], stay [off], goto here, release, status. ChatOrders adds: stop, pull, heal, passive,
# aggressive. A selector may come first: all, tank, healer, dps, a class name (rogue, rogues), or a comma list: "healer follow", "rogue,mage stay".
#   .bots follow | .bots healer stay | .bots status | .bots autogear     (goto here, pull and heal are party chat only: they use your position / target)
# ChatCommands = 0
# ChatOrders = 0     (adds stop, pull, heal, passive, aggressive, summon, revive, mount, dismount; summon/revive/mount need Bot.Chat.Orders.Enabled in the core)
# ChatControl = 0    (the control panel: role tank|healer|dps|auto, stance aggressive|defensive|passive, focus [off], distance <yards>|default)
#   With ChatCommands = 1 a bot also accepts a party invite from a player. Dot commands: .bots spawn <race id> <class id> [level] | list |
#   alt add <name> | alt remove <name> | alt list (alts need Bot.Alt.Enabled = 1 in the core's worldserver.conf).
# ChatSay = 0        (a bot that takes an order answers with a short /say line; ChatSayMax caps how many bots of a group speak for one order, a whispered bot always answers)
# ChatSayMax = 3
# AutoGearEveryLevels = 5
#
# Supplies (layout 15, off by default): a bot short of ammunition, food or drink walks to the nearest vendor that sells what it can use and buys,
# and a resting bot eats or drinks what it carries. Needs Bot.Actions.Supplies in the core (on by default there). A hunter with no ammunition
# fights in melee until it has bought some. A trip that bought nothing (no money, the vendor out of stock) is tried again later, after a longer wait each time.
# Supplies = 0
# SupplyAmmoLow = 100       (a bot with fewer pieces of ammunition than this goes shopping ...)
# SupplyAmmoTarget = 400    (... and buys up to this many)
# SupplyFoodLow = 3         SupplyFoodTarget = 10
# SupplyDrinkLow = 3        SupplyDrinkTarget = 10     (drink: bots with mana only)
# SupplyTripSec = 120       (a bot that needs supplies makes a trip at most this often, 30..3600)

# Flight points (off by default). A bot not in a party replaces a walk of at least TaxiMinWalkYards with a flight from a flight master within
# TaxiMasterMaxYards that lies on the way. Bots know their faction's flight points and fly free (Bot.Taxi.* in the core, on by default there).
# Taxi = 0
# TaxiMinWalkYards = 1500   (a shorter walk is walked, 300..20000)
# TaxiMasterMaxYards = 600  (a flight master farther than this is not walked to, 50..5000)
# TaxiBlockedSec = 600      (after a refused flight the bot walks for this long, 10..86400)

# Auction house (off by default; doc/economy.md). An idle bot whose bags are at least AuctionBagFullPct used lists up to AuctionPerVisit
# green-or-better items it looted (never equipment, a quest item or a stack), at a price that is a percent of the vendor sell price.
# The core runs every auction 2 hours, so AuctionRunHours takes only 2. Needs the core's AuctionHouseAction (kList). Players can buy the listings.
# The module does not walk bots to an auctioneer yet: a visit happens only when a bot is already at one. Keys that the module does not
# use yet (AuctionRelistPct, AuctionBuyMaxPct, AuctionBrowsePerVisit) are read and checked but have no effect.
# Auction = 0
# AuctionSellPctGreen = 300     (green items: listed at this percent of the vendor price, 100..2000)
# AuctionSellPctBlue = 400      (blue items, 100..2000)
# AuctionSellPctEpic = 500      (epic and legendary items, 100..2000)
# AuctionBuyoutPct = 120        (the buyout is the starting bid times this percent, 100..500)
# AuctionRelistPct = 90         (not used yet: the second listing of an expired item, 50..100)
# AuctionRunHours = 2           (2 only: the core's run time)
# AuctionMinVendorCopper = 100  (an item a vendor would pay less than this for is not listed, 0..1000000 copper)
# AuctionBagFullPct = 60        (a visit happens when this share of the bag is used, 1..100; the module assumes 16 bag slots)
# AuctionPerVisit = 5           (items listed per visit, 1..20)
# AuctionListedMax = 10         (listings a bot has at once, 1..50)
# AuctionEverySec = 1800        (at most one visit per bot this often, 60..86400)
# AuctionBuyMaxPct = 40         (not used yet: the most of a bot's spendable money one purchase may cost, 1..100)
# AuctionBrowsePerVisit = 3     (not used yet: item entries a bot looks up per visit, 1..20)
# AuctionCallsPerTick = 4       (house calls the whole module makes per tick, 1..50)

# A scenario (doc 19 of the core): a repeatable test. A fixed roster is spawned at the staging place, dressed, put in one party,
# teleported to the entry, and walked along the route by its leader for the duration. One result line is written to stderr and to
# ScenarioResultFile: how it ended (complete, wipe, timeout, enter_failed), the furthest route point, deaths. The core needs
# Bot.Actions.Teleport = 1 for it. Use MaxBots >= the roster size; the ramp and the saved bots are not used while a scenario is set.
# Scenario = deadmines_a
# ScenarioRoster = 1:1,1:5,7:8,7:8,1:4          # race:class: Human warrior, Human priest, Gnome mage x2, Human rogue
# ScenarioLevel = 18
# ScenarioStaging = 0 -8913.2 554.5 93.8        # map x y z: where the bots log in (a city, so nothing attacks them)
# ScenarioEntry = 36 -14.57 -385.48 62.46       # map x y z: where the party enters the dungeon
# ScenarioDurationSec = 1200
# ScenarioBosses = 644:Rhahk'Zor,643:Sneed,1763:Gilnid,646:Mr. Smite,647:Captain Greenskin,645:Cookie,639:Edwin VanCleef  # creature entry:name; verify the entries on your world database
# ScenarioRoute1 = -191.7 -453.2 54.6           # the leader walks these in order
# ScenarioRoute2 = -289.5 -513.0 49.7
# ScenarioRoute3 = -177.4 -574.5 19.3
# ScenarioGear1 = 1234,5678                     # optional: items granted to a class instead of auto gear (needs Bot.Actions.Grant)
# ScenarioResultFile = scenario-results.log

# Live picture for the dashboard's map: the bots' positions and the units near them, as one JSON file rewritten in place every
# LiveEveryMs (250..10000). Use an absolute path the dashboard may read (for example in the server's log folder). Empty = off.
#   Module.forever-bots.LiveFile = /var/log/forever/sim/bots-live.json
#   Module.forever-bots.LiveEveryMs = 1000

# A dungeon run (doc/dungeons.md): the scenario keys above come from a dungeon file; keys you set here win over the file.
# DungeonFile = data/dungeons.txt
# Per-dungeon JSON files (doc/dungeon-strategy.md): data/dungeons/<map id>-<name>.json, found beside DungeonFile without setting anything (or name the folder with
# DungeonDataDir). Your own folder, with a file for a map replacing the shipped one, is DungeonDir (an absolute path). A changed file is read again on a config reload.
# Module.forever-bots.DungeonDir = /srv/forever/sim/dungeons-mine
# Dungeon = rfc
# ScenarioRequireBosses = 1                      # complete when every boss of ScenarioBosses is seen dead (the dungeon file turns it on when it lists bosses)

# Mounts: a bot asks to mount up for a long walk only from MountMinLevel (default 40: classic riding is learned at 40; 0 = any level).
# Module.forever-bots.MountMinLevel = 40

# Crafting and gathering (SDK 0.18). Crafting = 1 (default) makes bots craft First Aid and Cooking and, with their profession, Blacksmithing, Leatherworking, Alchemy,
# Tailoring, Engineering and Smelting. A recipe that needs an anvil, forge or cooking fire sends the bot to the nearest one in CraftingFociFile (absolute path;
# data/crafting_foci.txt lists the capitals' objects). Gathering = 1 makes a bot with Mining, Herbalism or Skinning gather what is within 30 yards (off by default).
# Module.forever-bots.CraftingFociFile = /srv/forever/sim/modules_runtime/forever-bots/data/crafting_foci.txt
# Module.forever-bots.Gathering = 1
