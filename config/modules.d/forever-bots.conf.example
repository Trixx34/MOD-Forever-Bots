# Settings for the forever-bots module. Copy this file to worldserver.conf.d/modules.d/forever-bots.conf (under the config directory). The core loads every .conf file under worldserver.conf.d at start-up and sends each
# Module.forever-bots.<Key> entry to the module, with the prefix removed.

# Most bots the module controls at once (1..16).
Module.forever-bots.MaxBots = 1

# Race and class the module spawns bots with. Valid ids for the core's race and class tables.
Module.forever-bots.Race = 1
Module.forever-bots.Class = 1

# Telemetry: one CSV line per event and per summary interval, appended to this file (relative to the module's working directory; use an absolute path to be sure).
# Leave TelemetryFile empty to turn it off. TelemetrySummarySec is the seconds between summary lines per bot (1..3600).
Module.forever-bots.TelemetryFile = forever-bots-telemetry.csv
Module.forever-bots.TelemetrySummarySec = 60
# Stall watch (tagging only): a bot that is alive, out of combat and has not moved, levelled, changed its money or had an action applied for
# this many minutes writes a "stalled" telemetry line (and "unstalled" when it moves again). 0 (default) turns it off.
#   Module.forever-bots.StallAfterMinutes = 10

# Scale run (1500 bots): Race and Class may be "random" (a seeded pick over the valid combinations; see src/bot_pick.h).
# RandomSeed makes the same bots come back for the same seed.
#   Module.forever-bots.Race = random
#   Module.forever-bots.Class = random
#   Module.forever-bots.RandomSeed = 20261012
#
# The ramp: start at BotsInitial, add BotsStep every BotsStepMinutes, never above BotsCap, and stop adding at BotsStopTime
# (local time). The core ends the run at the same time (Bot.Run.StopTime in worldserver.conf).
#   Module.forever-bots.MaxBots = 1500
#   Module.forever-bots.BotsInitial = 300
#   Module.forever-bots.BotsStep = 100
#   Module.forever-bots.BotsStepMinutes = 15
#   Module.forever-bots.BotsCap = 1500
#   Module.forever-bots.BotsStopTime = 06:00
#
# The telemetry file rotates at TelemetryMaxMB, keeping TelemetryKeep older files (file.1 is the newest).
#   Module.forever-bots.TelemetryMaxMB = 256
#   Module.forever-bots.TelemetryKeep = 8

# Services (M3): an idle bot visits a vendor (sell grey, repair, equip) every ServiceEverySec seconds. The bot must be in
# interaction range of the NPC, which the core checks; it walks to the nearest vendor first (M6).
#   Module.forever-bots.ServiceEverySec = 600
# The trainer check (M4) is off by default, since bots learn their spells on level-up. TrainEverySec (60..86400) turns it
# on: the bot checks the trainer every that many seconds, and at once after a level-up, when a trainer is in range.
#   Module.forever-bots.TrainEverySec = 600

# Parties (M8): PartyCount parties of PartySize bots, cut from the lowest-guid bots in guid order. PartySize 0 turns
# parties off (the default); at most 5. A party's leader is its first warrior, else its lowest-guid bot. The core applies
# the invites and the group rules; the module only sends the actions. Needs the core with layout 5 (party state).
#   Module.forever-bots.PartySize = 5
#   Module.forever-bots.PartyCount = 1

# Travel (M6): an idle bot due a vendor visit (ServiceEverySec) walks to the nearest vendor on its own map and visits it.
# The core finds the vendor (layout 6 core). Needs no position settings.

# Hubs (M7): a bot that has seen nothing and done nothing for 30 s walks to the next hub of its map, waits there, and walks
# on to the next one after a full interval. Keys Hub<map>_<n> = "x y z", n from 1, in order. Hubs of map 0 and map 1 only.
# A bot with no hubs on its map does not wander. Needs the layout 7 core (map id in the snapshot).
# The hubs are the three biggest quest-giver clusters per map on the sim (rough centres: averages of the cell's givers).
# Map 0: Brill area, south Stranglethorn-side cluster, and the far-west cluster. Map 1: the three largest, well apart.
# A centre may sit in rock or on a roof; a bot that cannot reach it within the walk timeout just tries the next hub.
#   Module.forever-bots.Hub0_1 = 2265.2 269.3 36.5
#   Module.forever-bots.Hub0_2 = 2288.2 -5330.0 87.6
#   Module.forever-bots.Hub0_3 = -14447.1 474.8 19.6
#   Module.forever-bots.Hub1_1 = 2490.5 1903.5 351.2
#   Module.forever-bots.Hub1_2 = -3698.6 -4492.0 25.3
#   Module.forever-bots.Hub1_3 = 6475.8 481.2 9.9

# Quests (M5). The starter quest data file (see data/starter_quests.txt and src/quest_data.h). A bot near one of its starts accepts
# the quests of that start in order, hunts their targets, and hands them in; a bot with no start nearby grinds as before. Empty
# turns quests off.
# QuestFile = data/starter_quests.txt
# A whole-world quest file (levels 1 to 60, made by tools/make_world_quests.py, doc/world-quests.md) works the same way: the bot takes quests that suit its
# level, race and class from the nearest area that has some, and moves on to the next area when one is used up.
# QuestFile = data/world_quests.txt
# Quest lists per faction and band (all optional; a missing one falls back: level 60 list -> the side's leveling list -> QuestFile). A bot uses the list of its
# side (Alliance or Horde); from level 60 it uses the "60" list. Made with tools/make_world_quests.py --side alliance|horde and --min-level 60.
# QuestFileAlliance = data/world_quests_alliance.txt
# QuestFileHorde = data/world_quests_horde.txt
# QuestFileAlliance60 = data/world_quests_alliance_60.txt
# QuestFileHorde60 = data/world_quests_horde_60.txt
# A walk to a giver that does not move for two minutes is dropped (the bot grinds) unless this is 1. 1 teleports the bot to the giver
# once; the core still refuses that unless Bot.Actions.Teleport = 1. A refused teleport drops the start either way.
# QuestTeleport = 0

# Auto gear. 1 = the core dresses every bot for its class and level when it first appears and after it gains AutoGearEveryLevels levels
# (best usable item per slot, uncommon quality at most; Bot.AutoGear.MaxQuality in the core's config). Off by default. With it off, a
# player in a party can type .autogear to dress the bots that player leads.
# AutoGearing = 0
#
# Talent respec. 1 = a bot whose role or spec changed after it spent talent points has them taken back and spent by the new role (at most
# once an hour per bot). Needs Bot.Talents.Respec = 1 in the core's worldserver.conf, which pays the reset cost from the bot's gold. Off by default.
# TalentRespec = 0
#
# Rotations from a file: fight rows and upkeep buffs for all classes up to level 60, with the real spell ids from the core's ability dump
# (tools/make_rotations.py, doc/rotations.md). Without it the built-in rank 1 rotations are used.
# RotationFile = "data/rotations.txt"        # the default (a relative path is looked up beside the module executable); "" uses the built-in rank 1 rows
# TameBeastFile = "data/tame_beasts.txt"      # the beasts a hunter may tame (Tame Beast); "" = hunters do not tame
#
# Grind spots (leveling): idle bots walk to the spots that suit their level instead of their map's hubs. The file is made from the world database
# (tools/make_grind_spots.py, doc/grind-spots.md).
# GrindFile = "data/grind_spots.txt"
#
# Chat commands (party chat, raid chat, or a whisper to one bot; or the .bots dot command). Both are off by default. Only the leader of a group
# can command the bots in it. ChatCommands: follow [off], stay [off], goto here, release, status. ChatOrders adds: stop, pull, heal, passive,
# aggressive. A selector may come first: all, tank, healer, dps, a class name (rogue, rogues), or a comma list: "healer follow", "rogue,mage stay".
#   .bots follow | .bots healer stay | .bots status | .bots autogear     (goto here, pull and heal are party chat only: they use your position / target)
# ChatCommands = 0
# ChatOrders = 0     (adds stop, pull, heal, passive, aggressive, summon, revive, mount, dismount; summon/revive/mount need Bot.Chat.Orders.Enabled in the core)
# ChatControl = 0    (the control panel: role tank|healer|dps|auto, stance aggressive|defensive|passive, focus [off], distance <yards>|default)
#   With ChatCommands = 1 a bot also accepts a party invite from a player. Dot commands: .bots spawn <race id> <class id> [level] | list |
#   alt add <name> | alt remove <name> | alt list (alts need Bot.Alt.Enabled = 1 in the core's worldserver.conf).
# ChatSay = 0        (a bot that takes an order answers with a short /say line; ChatSayMax caps how many bots of a group speak for one order, a whispered bot always answers)
# ChatSayMax = 3

# AmbientChat = 0    (ambient chat: a bot says a short line on General or Trade now and then, and a level-up gets a line; the core must allow it too,
#                     Bot.Chat.Ambient.Enabled in worldserver.conf. Trade is refused outside the capitals.)
# AmbientPerMin = 2  (lines a minute over all bots, module side; keep it at or under Bot.Chat.Ambient.GlobalPerMin)
# AmbientBotCooldownSec = 300  (the least time between two lines of one bot)
# AmbientChannels = 1  (1 General, 2 Trade, 3 both)
# AmbientFile = data/ambient_lines.txt  (the line pool; see the header of that file for its format)
# ChatWhisperReplies = 0  (a bot answers a whisper that asks hello, its status, where it is, or for a group, and says why it is busy when an invite or trade comes in)
# WhisperCooldownMs = 60000  (per player and bot; 0 to 600000)
# WhisperMaxPerMin = 6       (per player, over all bots; 1 to 60)
# LfgFill = 0        (a human's party short of a tank or a healer is offered free bots: they teleport over and whisper their role to the leader, who invites them;
#                     offers go to a party at most every 5 minutes and to a bot at most every 10 minutes; bots within 5 levels of the party's highest level only)
# Second-list features, all off by default. Duels, Battlegrounds, GuildJoin and MailGifts send the SDK actions BotDuel, BotBattleground, BotGuild and BotGiftMail;
# they need a core with those actions (the core's Bot.Social.Enabled = 1). A core without them refuses the request and the module logs a *_gap event.
# MailGifts also lists the bot's bags, which needs the core's Bot.Trade.Enabled = 1. InnDowntime is still logic only.
# Duels = 0
# DuelMinLevel = 10
# DuelCooldownMin = 30
# Battlegrounds = 0
# BattlegroundMinLevel = 10
# BattlegroundMaxWaitMin = 10
# InnDowntime = 0
# InnHealthBelowPct = 50
# InnPowerBelowPct = 30
# InnMaxRestMin = 10
# GuildJoin = 0
# Bot guilds (protocol 24: the core runs GuildAction create and invite). The pool of online bots is planned into guilds of three purposes: leveling
# (below GuildsLevelCap, leaves at the cap; not capped), utility (not capped) and raiding (RaidMinLevel and up; at most GuildsRaidSize bots). Each guild has one
# faction. Off by default: nothing is planned or sent.
# GuildsEnabled = 0
# GuildsLevelCap = 60
# GuildsRaidMinLevel = 60
# GuildsRaidSize = 40
# GuildsLevelingShare = 60
# GuildsRaidingShare = 20
# GuildsUtilityShare = 20
# MailGifts = 0
# MailGiftDailyCap = 1
# AutoGearEveryLevels = 5
#
# Realism without combat (docs/bot-realism-backlog.md items 1 to 5 and 7), all off by default. None of them touches a fight: each acts only out of combat,
# with no target and nothing hostile in view.
# IdleFidget = 0         (a bot waiting for its flight to start stands or takes a short step now and then; only 4 s after the order, while idle)
# IdleFidgetChancePct = 30
# IdleFidgetMinSec = 3   / IdleFidgetMaxSec = 10   (the gap between two checks of one bot)
# IdleFidgetStandWeight = 2 / IdleFidgetStepWeight = 2 / IdleFidgetTurnWeight = 1
# ReadDelay = 0          (a bot waits 3 to 12 s after opening a quest or a trainer before it accepts or trains)
# ReadDelayMinSec = 3
# ReadDelayMaxSec = 12
# PassingBuff = 0        (a low-chance upkeep buff on a friendly player within 15 yards, out of combat, from the buff rows of the rotation)
# PassingBuffChancePct = 10
# PassingBuffManaAbovePct = 80   (and the mana of PassingBuffReserveCasts of the bot's own fight casts is always kept back)
# PassingBuffReserveCasts = 4
# PassingBuffCooldownSec = 600   (per bot)
# PassingBuffZonePerMin = 2      (over all bots of one map)
# TownAfk = 0            (a bot that reaches a hub sometimes stays 5 to 20 minutes before it walks on)
# TownAfkChancePct = 10
# TownAfkMinMin = 5
# TownAfkMaxMin = 20
# TownAfkZoneMax = 5     (bots staying at once per map)
#
# Advisor features (ten, all off by default; each acts only for a bot that is out of combat, has no target and sees no hostile; none touches a fight).
# LfgQueueFill = 0       (protocol 21: when a dungeon finder queue has waited LfgQueueFillWaitSec and still misses a role, one idle bot with no group joins it
#                         in that role; not the same as LfgFill above, which sends free bots to a human's party)
# LfgQueueFillWaitSec = 60
# LfgQueueFillCooldownSec = 120   (at most one bot per queue in this time)
# DeathPause = 0         (a dead bot waits a random time after the death before it sends release spirit; nothing else of the corpse run changes)
# DeathPauseMinSec = 10
# DeathPauseMaxSec = 30
# TradeAds = 0           (a bot whose skill in a crafting profession is at TradeAdsMinSkill or more posts one templated line on the Trade channel every
#                         TradeAdsIntervalMin minutes, from TradeAdsFile; it starts no trade; out of combat only)
# TradeAdsIntervalMin = 45
# TradeAdsMinSkill = 150
# TradeAdsFile = data/trade_ads.txt
# PartyMana = 0          (a healer or caster of a dungeon party below 20 percent mana, out of combat, says one line in party chat from PartyManaFile, and
#                         the party's non-combat movement holds until that bot is at 80 percent; never in combat)
# PartyManaHoldSec = 60  (hard cap of one hold)
# PartyManaFile = data/party_mana.txt
# WhisperMatrix = 0      (a whisper with "where are you", "inv", "group", "lfg", "what level" or "help" is answered from WhisperMatrixFile by the bot's state:
#                         grinding, questing, travelling, dungeon, full group; the whisper limit of ChatWhisperReplies applies, and no template goes to the
#                         same player twice in 10 minutes; works without ChatWhisperReplies, which keeps its own replies)
# WhisperMatrixFile = data/whisper_replies.txt
# PathJitter = 0         (an out-of-combat walking move target is offset by up to PathJitterYards in a random direction; never within 2 yards of a point
#                         the route data marks as not walkable (blocked grind spots), never across a required route waypoint, never in a dungeon or party route)
# PathJitterYards = 1.0  (0..5)
# GuildMilestone = 0     (protocol 21, guilds from the protocol 22 snapshot: when a player member of a guild that has a bot member gains a level, one random bot of the guild says a line from
#                         GuildMilestoneFile in guild chat, with the chance below; a second bot never answers the same event)
# GuildMilestoneChancePct = 30
# GuildMilestoneFile = data/guild_milestones.txt
# CityInspect = 0        (an idle bot in a capital that sees a player within 20 yards wearing a higher-level item than its own salutes, applauds or cheers at
#                         the player; the item levels and the capital test come from the core's snapshot (protocol 22, layout 23): inert on an older core)
# CityInspectChancePct = 5
# CityInspectZoneMax = 2 (emotes a minute over all bots of one map; and no more than one bot per player per 5 minutes)
# CityGreet = 0          (an idle bot in a capital that sees a player within 12 yards now and then says a line to the player in /say; a bot at the auction
#                         house, the auctioneer within 10 yards, uses data/auction_talk.txt; one bot per player per 10 minutes)
# CityGreetChancePct = 5
# TransportRide = 0      (a bot in a group whose leader stands on a ship, zeppelin or elevator is put on the same transport (kTransport, join), and taken off when the
#                         leader gets off; a passenger gets no world-coordinate move. Needs the core's Bot.Actions.Transport = 1 and Bot.Snapshot.PartyView = 1; a refusal
#                         backs the bot off. doc/transports.md)
# TransportRideEveryMs = 5000
# TransportRideBackoffMs = 30000
# CityGreetZoneMax = 2   (lines a minute over all bots of one map)
# CityGreetFile = data/city_greetings.txt
# AuctionTalkFile = data/auction_talk.txt
# QuestInvite = 0        (an idle bot and a human on the same quest objective, the human within 30 yards: the bot invites the human to its group, once per
#                         human per 30 minutes, never within 2 hours of a decline; the shared objective comes from the snapshot and a decline from the protocol 22
#                         event GroupScript.OnInviteDeclined)
# QuestGroups = 0        (group quests: quests marked 'group <n>' in the level 60 lists are taken, and the bot waits for a party of n. The lowest guid of the bots
#                         waiting for the same quest leads: it invites free bots in range that have the quest in their log, then guild mates, through the
#                         group action; the party walks behind the leader, who hands in; the party is disbanded when the quest leaves the leader's log. A wait
#                         with no party for QuestGroupWaitMinutes abandons the quest, which is then left alone for an hour. Needs QuestFile or the QuestFile*
#                         lists built with `make_world_quests.py --groups`)
# QuestGroupWaitMinutes = 10
# QuestGroupRangeYards = 150
# QuestGroupGuildHelpers = 1  (guild mates without the quest join the party too)
# ADVISOR-DOCS-ANCHOR
# AuctionRoundStep = 0   (copper; 10000 rounds a goods unit price to a gold, half a gold or just under; 0 = off)
# AuctionRoundMaxPct = 5 (how far the rounded price may lie from the computed one, and never below the vendor price)
#
# VendorSellGear (protocol 27, on by default): a vendor visit also sells the bag gear the worn gear outclasses (green or lower, usable, not a quest or set item,
# every slot of its type worn by an item with a higher item level and score, judged by the item numbers with the stat list of the bot's spec; never by item id).
# Needs Bot.Vendor.SellGear = 1 in the core, which refuses the sale otherwise; each sale is logged there as vendor_sell_gear.
# VendorSellGear = 1

# Spirit healer (protocol 28; needs Bot.Actions.SpiritHealer = 1 in the core, the default): a ghost that stands at its corpse with a live hostile within 30 yards would
# reclaim next to it (the reclaimed body comes back at half health, on the spot) and often dies again: a death loop. It takes the spirit healer instead (kResurrect
# spell_id 2): 50% health, resurrection sickness and a durability loss, but at the graveyard. The core walks the ghost to the nearest spirit healer within 40 yards and
# falls back to the plain reclaim on a map with none. A refused answer sends the ghost back to the old wait (up to two minutes) and reclaim for two minutes.
# SpiritHealerAfterMs: how long the hostile must have stood near the corpse before the ghost takes the spirit healer (0 = not for that reason).
# SpiritHealerAfterMs = 45000
# SpiritHealerOnRepeat: the second death to the same creature entry within five minutes takes the spirit healer at once, while a hostile is near the corpse.
# SpiritHealerOnRepeat = 1

# HealDownrank (protocol 28, off by default): a healer casts a lower rank of its heal for a small deficit (kCastSpell with dest_x = 1 names the exact rank; the core
# answers kNotKnown for a rank the bot has not learned, and the healer then casts the highest rank as before). Saves mana, costs more casts.
# HealDownrank = 0

# DPS threat discipline (on by default; needs Bot.Snapshot.Threat in the core, else the threat fields stay empty and nothing happens): a damage dealer in a party
# whose threat on its target reaches ThreatHoldPct percent of the top stops attacking that target until it is at or under ThreatReleasePct, for at most
# ThreatHoldMaxSec seconds (then it fights for as long again before it may hold anew). Not for the tank, a healer or a solo bot, not while the target is under
# ThreatNearDeathPct percent health, and not while the target is already attacking the bot (holding then does nothing). ThreatDropAbilities: a bot that is on top of
# the threat list or has the target's attention also uses its class's threat drop (priest Fade, hunter Feign Death, rogue Feint, druid Cower) when it has one.
# ThreatHold = 1
# ThreatHoldPct = 90          (1-100)
# ThreatReleasePct = 70       (0-99, under ThreatHoldPct)
# ThreatHoldMaxSec = 8        (1-60)
# ThreatNearDeathPct = 15     (0-100: 0 holds to the end)
# ThreatDropAbilities = 1

# Supplies (layout 15, off by default): a bot short of ammunition, food or drink walks to the nearest vendor that sells what it can use and buys,
# and a resting bot eats or drinks what it carries. Needs Bot.Actions.Supplies in the core (on by default there). A hunter with no ammunition
# fights in melee until it has bought some. A trip that bought nothing (no money, the vendor out of stock) is tried again later, after a longer wait each time.
# Supplies = 0
# SupplyAmmoLow = 100       (a bot with fewer pieces of ammunition than this goes shopping ...)
# SupplyAmmoTarget = 400    (... and buys up to this many)
# SupplyFoodLow = 3         SupplyFoodTarget = 10
# SupplyDrinkLow = 3        SupplyDrinkTarget = 10     (drink: bots with mana only)
# SupplyTripSec = 120       (a bot that needs supplies makes a trip at most this often, 30..3600)

# Flight points (off by default). A bot not in a party replaces a walk of at least TaxiMinWalkYards with a flight from a flight master within
# TaxiMasterMaxYards that lies on the way. Bots know their faction's flight points and fly free (Bot.Taxi.* in the core, on by default there).
# Taxi = 0
# TaxiMinWalkYards = 1500   (a shorter walk is walked, 300..20000)
# TaxiMasterMaxYards = 600  (a flight master farther than this is not walked to, 50..5000)
# TaxiBlockedSec = 600      (after a refused flight the bot walks for this long, 10..86400)

# Auction house (off by default; doc/economy.md). An idle bot whose bags are at least AuctionBagFullPct used lists up to AuctionPerVisit
# green-or-better items it looted (never equipment, a quest item or a stack), at a price that is a percent of the vendor sell price.
# The core runs every auction 2 hours, so AuctionRunHours takes only 2. Needs the core's AuctionHouseAction (kList). Players can buy the listings.
# The module does not walk bots to an auctioneer yet: a visit happens only when a bot is already at one. Keys that the module does not
# use yet (AuctionRelistPct, AuctionBuyMaxPct, AuctionBrowsePerVisit) are read and checked but have no effect.
# Auction = 0
# AuctionSellPctGreen = 300     (green items: listed at this percent of the vendor price, 100..2000)
# AuctionSellPctBlue = 400      (blue items, 100..2000)
# AuctionSellPctEpic = 500      (epic and legendary items, 100..2000)
# AuctionBuyoutPct = 120        (the buyout is the starting bid times this percent, 100..500)
# AuctionRelistPct = 90         (not used yet: the second listing of an expired item, 50..100)
# AuctionRunHours = 2           (2 only: the core's run time)
# AuctionMinVendorCopper = 100  (an item a vendor would pay less than this for is not listed, 0..1000000 copper)
# AuctionBagFullPct = 60        (a visit happens when this share of the bag is used, 1..100; the module assumes 16 bag slots)
# AuctionPerVisit = 5           (items listed per visit, 1..20)
# AuctionListedMax = 10         (listings a bot has at once, 1..50)
# AuctionGoodsSell = 1         (off by default: stacks of trade goods, white or better, that a bot does not need are listed as commodities at AuctionGoodsPct
#                              percent of the vendor's unit price, up to AuctionGoodsStackMax units a listing, AuctionGoodsPerEntryMax listings of one item,
#                              from AuctionGoodsMinQuality (1 white .. 4 epic); needs Auction = 1)
# AuctionGoodsPct = 150
# AuctionGoodsStackMax = 20
# AuctionGoodsPerEntryMax = 1
# AuctionGoodsMinQuality = 1
# AuctionEverySec = 1800        (at most one visit per bot this often, 60..86400)
# AhBatchIntervalHours = 0      (0 = off, 0..168. Above 0: a bot visits the auction house to list, relist or cancel only once per this many hours, and lists
#                                goods in stacks of 1, 5 or 20 chosen per item; with 0 the rules above stay as they are)
# AuctionBuy = 0                (off by default; needs Auction = 1 and a core with protocol 19. A bot also looks for upgrades: every AuctionEverySec it
#                                browses one equipment slot of the house in turn, the core says which listings beat what the bot wears (its AutoGear score),
#                                and the bot buys out the best upgrade per copper it can afford. Never in a scenario run. The item arrives by mail, which the
#                                core collects for bots.)
# AuctionBuyMaxPct = 40         (the most of a bot's spendable money (above the reserve) one purchase may cost, 1..100; used with AuctionBuy)
# AuctionBrowsePerVisit = 3     (not used yet: item entries a bot looks up per visit, 1..20)
# AuctionCallsPerTick = 4       (house calls the whole module makes per tick, 1..50)

# A scenario (doc 19 of the core): a repeatable test. A fixed roster is spawned at the staging place, dressed, put in one party,
# teleported to the entry, and walked along the route by its leader for the duration. One result line is written to stderr and to
# ScenarioResultFile: how it ended (complete, wipe, timeout, enter_failed), the furthest route point, deaths. The core needs
# Bot.Actions.Teleport = 1 for it. Use MaxBots >= the roster size; the ramp and the saved bots are not used while a scenario is set.
# Scenario = deadmines_a
# ScenarioRoster = 1:1,1:5,7:8,7:8,1:4          # race:class: Human warrior, Human priest, Gnome mage x2, Human rogue; race:class:spec picks the spec (1:1:prot,3:3:bm,7:9:demonology)
# ScenarioLevel = 18
# ScenarioStaging = 0 -8913.2 554.5 93.8        # map x y z: where the bots log in (a city, so nothing attacks them)
# ScenarioEntry = 36 -14.57 -385.48 62.46       # map x y z: where the party enters the dungeon
# ScenarioDurationSec = 1200
# ScenarioBosses = 644:Rhahk'Zor,643:Sneed,1763:Gilnid,646:Mr. Smite,647:Captain Greenskin,645:Cookie,639:Edwin VanCleef  # creature entry:name; verify the entries on your world database
# ScenarioRoute1 = -191.7 -453.2 54.6           # the leader walks these in order
# ScenarioRoute2 = -289.5 -513.0 49.7
# ScenarioRoute3 = -177.4 -574.5 19.3
# ScenarioGear1 = 1234,5678                     # optional: items granted to a class instead of auto gear (needs Bot.Actions.Grant)
# ScenarioResultFile = scenario-results.log
# 40-man raid support (doc 108): ScenarioRaid = 1 lets ScenarioRoster go up to 40 (TrinityCore's MAX_RAID_SIZE) and forms the roster into
# one raid group of 8 subgroups of 5 (Group::ConvertToRaid, Group::ChangeMembersGroup), instead of the flat 5-member party above. Without
# it ScenarioRoster is still capped at 5 exactly as before -- a raid is a distinct, opt-in mode, not a universal cap raise. List the roster
# as 8 repeats of the same tank/healer/dps composition a 5-man roster would use (one repeat per subgroup, in order): bot_policy.cpp assigns
# subgroup = roster position / 5, so a warrior at position 0, 5, 10, ... lands as each subgroup's tank the same way the single-party case
# already makes every warrior in a PartySize-roster its tank. (Example only -- a raid's own ScenarioEntry/ScenarioBosses/route for a given
# raid instance, e.g. Onyxia's Lair, are set up separately; not shown here.)
# Scenario = my_raid
# ScenarioRaid = 1
# ScenarioRoster = 1:1,1:5,1:4,1:4,1:4,1:1,1:5,1:4,1:4,1:4,1:1,1:5,1:4,1:4,1:4,1:1,1:5,1:4,1:4,1:4,1:1,1:5,1:4,1:4,1:4,1:1,1:5,1:4,1:4,1:4,1:1,1:5,1:4,1:4,1:4,1:1,1:5,1:4,1:4,1:4
# ScenarioLevel = 60
# ScenarioDurationSec = 5400
# Several dungeons in one run (0.29.0): a list of dungeon ids of the dungeon files, each with its parties (20 in all); "<key>.<id>" sets a key for one dungeon.
# The plain dungeon keys above (roster, level, staging, entry, portal, route, bosses, parties) are ignored with a list; the others apply to every dungeon.
# Scenario = dm:10,rfc:10
# ScenarioRoster.dm = 1:1,1:5,1:8,3:3,7:9
# ScenarioLevel.dm = 18
# ScenarioStaging.dm = 0 -8913 554 94
# ScenarioTameSpot.dm = 0 -10439.4 929.2 38.9   # map x y z: hunters without a pet are taken here to tame one (Westfall), and back, before the party forms
# ScenarioAmmo = 200                            # ammunition given to a hunter that has none, per grant, one stack at most (0 = none)
# ScenarioClassSupplies = 9:6265:10             # class:item:count after the gear (default: a warlock gets 10 Soul Shards)
# ScenarioClassQuests = 9:1504,3:6061           # off by default: class:quest completed with its reward in the dressing (core quest operation 4; the core refuses a quest not in the log)
# ScenarioLevel.rfc = 17
# Offline policy lab: each candidate applies to all ScenarioParties in that run. Defaults preserve current behavior;
# bounded parameter ranges are validated by the module. See tools/dungeon_learning/README.md.
# CorpseRunTeleportSec = 60   (a corpse run longer than this puts the ghost at its corpse, the four-minute teleport brought forward; 0 = off, 10 to 3600)
# GhostTeleportHold = 1   (a dungeon ghost's entrance or party teleport waits while a live hostile is within 30 yards of the destination; log: ghost_teleport_hold: ... reason=hostile; 0 = teleport at once as before)
# GhostTeleportHoldMaxMs = 120000   (the longest a ghost is held for a hostile, per death; 1000 to 3600000)
# DeathLockoutCount = 4   (a bot that died this many times within DeathLockoutWindowMs waits DeathLockoutHoldMs more before its ghost teleport, reason=lockout; 0 = off, else 2 to 50)
# DeathLockoutWindowMs = 600000   (10000 to 86400000)
# DeathLockoutHoldMs = 90000   (0 to 3600000)
# GhostTeleportPerSecond = 2   (at most this many ghost teleports a second, for the whole module: a wiped raid does not teleport 20 ghosts in one tick; 0 = no limit, 1 to 100)
#                            core; in a wipe the ghost is put at its corpse, needs Bot.Actions.Teleport. 0 = off, else 10..3600)
# DungeonHealBelowPct = 55
# DungeonTankHealBelowPct = 75
#                            (out of a fight the route leader is also healed up to 90%, whatever these say: it walks on only at 80%; since 0.30.0)
# HealerDpsManaPct = 40
# HealerCombatManaPct = 25   (a healer in a party fight keeps this share of its mana for heals: its attack rows such as Smite stop below it; 0 = no floor, 0 to 80; bug 11)
# TankPickup = 1   (a tank taunts the mobs that are on party members, and uses Challenging Shout or Roar for two or more; needs PartyViewPlanner = 1 and the core's
#                   Bot.Snapshot.PartyView and PartyThreat; 0 = off)
# HealerLosMoveYards = 6
# DamageEvents = 1   (take in the core's damage events, protocol 29: a bot's killing blows and hits of the core's Modules.DamageEvent.MinPct (20) percent of its max health or more, with the
#                     real attacker and spell: the died: line names the real killer, the run telemetry gets dmg_by_spell and dmg_by_attacker; 0 = ignore them)
# DamageEventMinPct = 20   (the module also drops a non-lethal hit below this percent of the bot's max health; 1 to 100; raise it above the core's MinPct to hear less)
# PullTankFirst = 1   (a dungeon, raid or tank-led party: the members wait on the route while the leader/tank has a target but is not in combat with it, and engage once
#                      it is; solo bots and leveling parties are never held; 0 = every member pulls on its own, as before)
# PullTankHoldMs = 12000   (the longest a member waits, so a dead or stuck tank cannot freeze the party; 1000 to 120000)
# PullMemberRangeYards = 12   (a target within this many yards of a member is engaged at once, no walk; 0 to 40)
# Combat drift of dungeon parties (0.45.0; a scenario or "tank lead" party with a route; the 2026-11-07 sim's fights pulled leaders 60-250 yards off the route):
# DungeonPullLeashYards = 30   (the route leader, out of a fight, pulls only a hostile within this many yards of the leg of the route it walks; 0 = off, else 10..80)
# DungeonChaseLeashYards = 40  (a party bot does not walk after, or pick in a fight, a hostile farther than this from both that leg and its leader: a member goes
#                               back to its leader, the leader stands, and they fight it when it comes back; 0 = off, else 10..80)
# DungeonLeaderRejoin = 1      (a dead leader comes back with its party: its corpse is stood up next to a quiet member, with the recover tactic and
#                               DungeonReviveOutOfCombat, and its ghost waits up to 60 s for the party's fight to end and is then teleported next to a living
#                               member, instead of resting alone at the entrance and walking back into the fight; 0 = the entrance, as before 0.45.0)

# Live picture for the dashboard's map: the bots' positions and the units near them, as one JSON file rewritten in place every
# LiveEveryMs (250..10000). Use an absolute path the dashboard may read (for example in the server's log folder). Empty = off.
#   Module.forever-bots.LiveFile = /var/log/forever/sim/bots-live.json
#   Module.forever-bots.LiveEveryMs = 1000

# A dungeon run (doc/dungeons.md): the scenario keys above come from a dungeon file; keys you set here win over the file.
# DungeonFile = data/dungeons.txt
# Per-dungeon JSON files (doc/dungeon-strategy.md): data/dungeons/<map id>-<name>.json, found beside DungeonFile without setting anything (or name the folder with
# DungeonDataDir). Your own folder, with a file for a map replacing the shipped one, is DungeonDir (an absolute path). A changed file is read again on a config reload.
# Module.forever-bots.DungeonDir = /srv/forever/sim/dungeons-mine
# Run telemetry of a scenario run (doc/dungeon-strategy.md, "Telemetry"): the party_tl:, party_stalled: and boss_attempt: lines, with an ISO time in front, are appended to
# <dir>/run-telemetry.log (read it with tools/run_telemetry.py). An absolute directory path; empty (default) = off. The lines are in the journal in any case.
# Module.forever-bots.RunTelemetryDir = /var/log/forever/sim
# Dungeon = rfc
# ScenarioRequireBosses = 1                      # complete when every boss of ScenarioBosses is seen dead (the dungeon file turns it on when it lists bosses)

# Ground effects (SDK 0.19): a bot standing in a harmful area (Flamestrike, Blizzard, a poison cloud) walks out of it. The core must have Bot.Snapshot.GroundEffects = 1. AvoidSpellsFile
# (absolute path; data/avoid_spells.txt) lists the dungeon spells that leave one; the dungeon files' bosses[].strategy.avoid_spells and avoid add to it. Off by default. doc/ground-effects.md.
# Module.forever-bots.AvoidGroundEffects = 1
# Module.forever-bots.AvoidSpellsFile = /srv/forever/sim/modules_runtime/forever-bots/data/avoid_spells.txt
# TelegraphEscape (default ON, acts only on maps that have raid rules; needs the core Bot.Snapshot.Telegraphs = 1): a bot inside the area of an enemy cast about to land (Onyxia Fireball,
# Deep Breath) steps out. A tank holds unless the spell is an `avoid|spell` or `frontal` row; a bot mid-cast holds unless the spell is an `avoid|spell` row or TelegraphEscapeCasters = 1.
# Module.forever-bots.TelegraphEscape = 1
# Module.forever-bots.TelegraphEscapeCasters = 0

# Party planner (party_planner.h): one plan per party every 400 ms, the nearest ready kicker assigned to each cast, crowd control split between casters. On by default; it acts through
# the interrupt and cc tactics (DungeonTactics), so with those off it changes nothing. 0 = off, every bot picks its own jobs as before. doc/dungeon-strategy.md.
# Module.forever-bots.PartyPlanner = 0
#
# PartyViewPlanner = 1: the planner also reads the core's shared party view (layout 25; needs Bot.Snapshot.PartyView = 1 in the core): human
# members, tank roles known by role, and the loose mobs on non-tanks. Default 0 (the bots-only merge); without a view it changes nothing.
# Module.forever-bots.PartyViewPlanner = 1
#
# RaidRulesFile (absolute path; data/raid_rules.txt): the raid rule table. Per raid map (Onyxia's Lair 249, Zul'Gurub 309 ship): the adds to kill first, the casts to interrupt
# first, the dispel kind of an aura (curse, magic, poison, disease), ground effects to step out of (needs AvoidGroundEffects = 1 and the core's Bot.Snapshot.GroundEffects = 1),
# the debuff that swaps the tanks and the no-area-damage fights. The party planner reads it, so it needs PartyPlanner on (the default). Empty = no rules. doc/raid-rules.md.
# Module.forever-bots.RaidRulesFile = /srv/forever/sim/modules_runtime/forever-bots/data/raid_rules.txt

# Mounts: a bot asks to mount up for a long walk only from MountMinLevel (default 40: classic riding is learned at 40; 0 = any level).
# Module.forever-bots.MountMinLevel = 40

# Crafting and gathering (SDK 0.18). Crafting = 1 (default) makes bots craft First Aid and Cooking and, with their profession, Blacksmithing, Leatherworking, Alchemy,
# Tailoring, Engineering and Smelting. A recipe that needs an anvil, forge or cooking fire sends the bot to the nearest one in CraftingFociFile (absolute path;
# data/crafting_foci.txt lists the capitals' objects). Gathering = 1 makes a bot with Mining, Herbalism or Skinning gather what is within 30 yards (off by default).
# Module.forever-bots.CraftingFociFile = /srv/forever/sim/modules_runtime/forever-bots/data/crafting_foci.txt
# Module.forever-bots.Gathering = 1
# GatherWalk = 1 (off by default; needs Gathering = 1): a gatherer with no node in sight walks to the nearest one of its skill in GatherNodesFile
# (absolute path; data/gather_nodes.txt is generated by tools/gen_gather_nodes.py from the world DB).
# Module.forever-bots.GatherWalk = 1
# Module.forever-bots.GatherNodesFile = /srv/forever/sim/modules_runtime/forever-bots/data/gather_nodes.txt

# Second-list features, all off by default (each reads a data file that ships empty until its entries are checked against the world DB).
# RidingTraining = 1 learns the riding ranks of RidingRankFile; WeaponTraining = 1 learns the class weapon skills at the class trainer.
# Fishing = 1 walks a bot with a pole to the nearest spot of FishingSpotFile (the cast needs a core action: doc/fishing.md).
# RareHunts = 1 fights the rare creatures of RareHuntFile in range of their levels. Tradeskill training is the errand trainer walk (Errands = 1).
# Module.forever-bots.RidingTraining = 0
# Module.forever-bots.RidingRankFile = /srv/forever/sim/modules_runtime/forever-bots/data/riding_ranks.txt
# Module.forever-bots.WeaponTraining = 0
# Module.forever-bots.Fishing = 0
# Module.forever-bots.FishingSpotFile = /srv/forever/sim/modules_runtime/forever-bots/data/fishing_spots.txt
# Module.forever-bots.RareHunts = 0
# Module.forever-bots.RareHuntFile = /srv/forever/sim/modules_runtime/forever-bots/data/rare_hunts.txt

# Bot guilds (off by default; the planner in src/bot_guilds.cpp). Three purposes: leveling (bots below LevelCap, released at the cap, empty guilds dissolved,
# not capped in size), utility (dungeons, professions, auction house; long-term, not capped) and raiding (RaidMinLevel and qualified; capped at RaidSize).
# A bot with no set purpose takes its purpose from its guid and these shares (percent, must add up to 100).
# Bot.Guilds.Enabled = 0
# Bot.Guilds.LevelCap = 60
# Bot.Guilds.RaidMinLevel = 60
# Bot.Guilds.LevelingShare = 60
# Bot.Guilds.RaidingShare = 20
# Bot.Guilds.UtilityShare = 20
# Bot.Guilds.RaidSize = 40

# ---- Keys that were only described in the code (src/bot_settings.h) before. Every key shows its default; the value here is the default unless said.

# Scenario run control (the Scenario keys above): more parties, wipe handling and abort rules. They apply to the scenario (or to the dungeon named in "<key>.<id>").
# ScenarioParties = 1                # (1..200) this many parties of the roster run at the same time, each in its own instance; MaxBots must cover parties x roster
# ScenarioWipeRecovery = 0           # 1: all down is not the end while a ghost may still come back (a reclaiming ghost keeps the run going)
# ScenarioWipeRecoverySec = 300      # (10..3600) how long the recovery may last before the run ends as a wipe
# ScenarioMinAlive = 0               # (0..5) the run ends as understrength when fewer members than this are alive; 0 = off
# ScenarioLeaderDeadAbandonSec = 0   # (0..3600) the run is abandoned when the leader stays dead this long; 0 = off
# ScenarioConfigGuard = 0            # 1: a scenario waits until the core applied a teleport the module sent, and ends as config_refused when the core refuses
#                                    # it (Bot.Actions.Teleport or Bot.Actions.Grant off) instead of running in the wrong place

# The dungeon facts of a scenario, the same values the dungeon JSON file gives (doc/dungeon-strategy.md). A key set here wins over the file.
# ScenarioPortal = 0 -8913.2 554.5 93.8   # map x y z: the instance door, outside (default: none)
# ScenarioBossAt = 3:639                  # route point (1-based) : boss entry standing there; a comma list (default: none)
# ScenarioKillPriority = 644,643          # creature entries in the order the party kills them (default: none)
# ScenarioSummons = 598,1730              # creature entries the dungeon's summoners make; used only when DungeonSummons lists the dungeon (default: none)
# ScenarioTameSpot = 0 -10439 929 39      # map x y z: where a hunter without a pet goes to tame one before the party forms (default: none, hunters stay where they are)
# DungeonSummons = dm,rfc                 # scenario names whose summons the party fights first (default: empty = off)
# DungeonTactics = none                   # "focus,interrupt,heal,rest,recover,cc", "all" or "none" (default none): which dungeon party tactics are on
# DungeonDataDir = data/dungeons          # folder of the shipped per-dungeon JSON files (default: "dungeons" beside DungeonFile); read again on a config reload
# DungeonEventsFile = data/dungeon_events.txt   # the events table for all dungeons: doors to open, charges to fire (default: empty = none)
# DungeonTeleport = 0                     # 1: lost dungeon bots are put back by teleport (tests and scenarios; needs Bot.Actions.Teleport in the core)
# DungeonReviveOutOfCombat = 0            # 1: the leader revives a dead party member out of combat (needs Bot.Chat.Orders.Enabled in the core)

# Level dungeons and LFG: a levelling bot party runs each dungeon of the dungeon file when its level reaches the dungeon's max level.
# LevelDungeons = 1                  # on by default
# LevelDungeonRuns = 2               # (1..5) most runs of one dungeon per party
# LfgCommand = 1                     # on by default: "LFG <dungeon>" in the General or Trade channel brings free bots to the speaker

# Crafting = 1                       # on by default: a bot with nothing to fight makes bandages from its cloth and cooks its meat (raises First Aid and Cooking); 0 turns it off

# Test and diagnostics.
# TestSpell = 0                      # spell id cast at the attack target on a timer to test the cast path; 0 = off
# ActionStats = 0                    # 1: once a minute the log lists the ten (bot, action, spell) combinations sent most often ("actions_top"), to find a bot that repeats an action
# AggressiveStart = 0                # 1: bots start Aggressive (a lone bot pulls creatures of its level and levels); the default stance only fights what attacks it

# Randomness (follows RandomSeed, so a run with the same seed behaves the same).
# PartyPercent = 30                  # (0..100) share of the bots that take part in parties at all; the others play alone
# RandomPct = 25                     # (0..90) how much the bots' timers and walks vary, plus or minus this percent; 0 = none

# Level brackets (off by default; needs Presence = 1, the level counts come from the presence feed). The ramp places each new bot in the bracket furthest short of its share.
# BracketsEnabled = 0
# BracketTargets = 1-9:25,10-19:20,20-29:15,30-39:12,40-49:12,50-59:11,60:5   # weight per level bracket (normalized; an unlisted bracket gets 0)
# BracketSpotCap = 0                 # (0..1000) most bots per grind spot; 0 = no cap
# BracketStalledMinutes = 0          # (0..1440) no level gain for this long marks a bot as stalled; 0 = off
# BracketMoveDown = 0                # 1: a stalled bot is sent to a grind spot one bracket down
# RetireLevel60 = off                # off | release: "release" lets a bot that reaches level 60 go (the core has no delete action)

# Bot presence: bots log off and on like players, by the time of day (off by default; needs Bot.Presence.LogoutOnRelease in the core, doc/presence.md).
# Presence = 0
# PresenceOnlineMinMin = 60          # (1..1440) a session lasts between these many minutes ...
# PresenceOnlineMaxMin = 240         # ... and this many
# PresenceOfflineMinMin = 30         # (1..1440) a bot then stays away between these many minutes ...
# PresenceOfflineMaxMin = 240        # ... and this many
# PresenceMinOnline = 0              # (0..100000) never fewer ordinary bots online than this
# PresenceMaxOnline = 0              # (0..100000) never more than this at once; 0 = no cap
# PresenceDayPercent = 25,20,15,12,10,10,12,18,25,32,38,42,48,52,55,60,68,78,88,95,100,95,75,45   # 24 values: most of the population in percent that may be around at each local hour

# Supplies, second list (the keys above cover ammunition, food and drink; Supplies = 1 is needed). Potions, bandages and reagents are each off by default.
# SupplyPotions = 0                  # buy health potions (and mana potions for a mana user) and drink them in a fight
# SupplyBandages = 0                 # buy bandages and use them out of combat
# SupplyReagents = 0                 # buy the reagent the core says a refused cast was missing
# SupplyHealthPotionLow = 1          # (0..20) a bot with fewer health potions than this goes shopping
# SupplyManaPotionLow = 1            # (0..20) the same for mana potions
# SupplyBandageLow = 3               # (0..50) the same for bandages
# UseHealthPotionBelowPct = 35       # (1..90) in a fight a bot below this health drinks a health potion
# UseManaPotionBelowPct = 25         # (1..90) ... and below this mana (a mana user) a mana potion
# UseBandageBelowPct = 60            # (1..95) a resting bot below this health, with no food to eat, bandages itself

# Vendor sales of white items a bot does not need (off by default; doc/economy.md). Equipment is never sold here.
# SellVendor = 0
# SellEverySec = 1800                # (60..86400) a bot visits a vendor to sell at most this often
# SellPerVisit = 8                   # (1..20) distinct items sold in one visit

# Town errands (profession training trips to a capital trainer; Errands = 1 turns them on, off by default).
# ErrandDailyMin = 60                # (1..1440) errand minutes a bot may spend in any rolling 24 hours
# ErrandGapMin = 120                 # (0..1440) a bot's next errand starts no sooner than this after its last one ended
# ErrandMaxMin = 60                  # (5..240) one errand runs no longer than this
# ErrandPerCity = 2                  # (1..20) bots out on an errand to one capital at once
# ErrandStartsPerTick = 2            # (1..10) errands started in one tick, the whole module
# ErrandTrainerFile = data/errand_trainers.txt   # the trainer table

# Spell costs: what each spell costs in mana, rage or energy, so a bot does not try a cast it cannot pay for.
# SpellCostFile =                    # default empty = no check (the core refuses the cast instead)
