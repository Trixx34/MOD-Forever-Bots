# Settings for the forever-bots module. Copy this file to worldserver.conf.d/modules.d/forever-bots.conf (under the config directory). The core loads every .conf file under worldserver.conf.d at start-up and sends each
# Module.forever-bots.<Key> entry to the module, with the prefix removed.

# Most bots the module controls at once (1..16).
Module.forever-bots.MaxBots = 1

# Race and class the module spawns bots with. Valid ids for the core's race and class tables.
Module.forever-bots.Race = 1
Module.forever-bots.Class = 1

# Telemetry: one CSV line per event and per summary interval, appended to this file (relative to the module's working directory; use an absolute path to be sure).
# Leave TelemetryFile empty to turn it off. TelemetrySummarySec is the seconds between summary lines per bot (1..3600).
Module.forever-bots.TelemetryFile = forever-bots-telemetry.csv
Module.forever-bots.TelemetrySummarySec = 60

# Scale run (1500 bots): Race and Class may be "random" (a seeded pick over the valid combinations; see src/bot_pick.h).
# RandomSeed makes the same bots come back for the same seed.
#   Module.forever-bots.Race = random
#   Module.forever-bots.Class = random
#   Module.forever-bots.RandomSeed = 20261012
#
# The ramp: start at BotsInitial, add BotsStep every BotsStepMinutes, never above BotsCap, and stop adding at BotsStopTime
# (local time). The core ends the run at the same time (Bot.Run.StopTime in worldserver.conf).
#   Module.forever-bots.MaxBots = 1500
#   Module.forever-bots.BotsInitial = 300
#   Module.forever-bots.BotsStep = 100
#   Module.forever-bots.BotsStepMinutes = 15
#   Module.forever-bots.BotsCap = 1500
#   Module.forever-bots.BotsStopTime = 06:00
#
# The telemetry file rotates at TelemetryMaxMB, keeping TelemetryKeep older files (file.1 is the newest).
#   Module.forever-bots.TelemetryMaxMB = 256
#   Module.forever-bots.TelemetryKeep = 8

# Services (M3, M4): an idle bot visits a vendor (sell grey, repair, equip) every ServiceEverySec seconds, and checks its
# trainer every TrainEverySec seconds (and at once after a level-up). The bot must be in interaction range of the NPC,
# which the core checks: walking there is travel (M6), not done yet.
#   Module.forever-bots.ServiceEverySec = 600
#   Module.forever-bots.TrainEverySec = 600

# Parties (M8): PartyCount parties of PartySize bots, cut from the lowest-guid bots in guid order. PartySize 0 turns
# parties off (the default); at most 5. A party's leader is its first warrior, else its lowest-guid bot. The core applies
# the invites and the group rules; the module only sends the actions. Needs the core with layout 5 (party state).
#   Module.forever-bots.PartySize = 5
#   Module.forever-bots.PartyCount = 1

# Travel (M6): where each race's vendor stands in its start city, as "x y z" on the bot's start map, keyed by race id
# (1 Human, 2 Orc, 3 Dwarf, 4 Night Elf, 5 Undead, 6 Tauren, 7 Gnome, 8 Troll, 10 Blood Elf, 11 Draenei, 22 Worgen).
# An idle bot due a vendor visit (ServiceEverySec) walks there, then visits. A race with no entry does not travel.
# Start maps: 0 for Human, Dwarf, Gnome and Undead; 1 for Orc, Troll, Night Elf and Tauren. The module does not check the
# map, so a bot must stay on its start map. Positions are the vendor nearest each race's start (sim world DB, Classic
# start).
#   Module.forever-bots.VendorPos1 = -8909.46 -104.16 82.03     # Human: Janos Hammerknuckle (Northshire, map 0)
#   Module.forever-bots.VendorPos2 = -565.43 -4214.20 41.67     # Orc: Duokna (Valley of Trials, map 1)
#   Module.forever-bots.VendorPos3 = -6226.67 320.05 383.14     # Dwarf: Adlin Pridedrift (Coldridge Valley, map 0)
#   Module.forever-bots.VendorPos4 = 10436.70 794.84 1322.79    # Night Elf: Keina (Shadowglen, map 1)
#   Module.forever-bots.VendorPos5 = 1836.77 1641.04 97.71      # Undead: Kayla Smithe (Deathknell, map 0)
#   Module.forever-bots.VendorPos6 = -2940.84 -245.96 53.89     # Tauren: Moodan Sungrain (Camp Narache, map 1)
#   Module.forever-bots.VendorPos7 = -6226.67 320.05 383.14     # Gnome: Adlin Pridedrift (shares the Dwarf start, map 0)
#   Module.forever-bots.VendorPos8 = -565.43 -4214.20 41.67     # Troll: Duokna (shares the Orc start, map 1)
